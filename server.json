{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "app.recordist/gateway",
  "description": "Read, search and act on meetings Recordist recorded on your Mac. Listens on loopback by default.",
  "repository": {
    "url": "https://github.com/recordist-app/gateway",
    "source": "github"
  },
  "websiteUrl": "https://recordist.app/developers/mcp",
  "version": "0.1.6",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@recordist/gateway",
      "version": "0.1.6",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "RECORDIST_API_URL",
          "description": "Local API base URL (default http://127.0.0.1:47321)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
